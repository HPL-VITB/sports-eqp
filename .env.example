# Copy to .env.local for development. In production set these in Vercel > Project > Settings > Environment Variables.
# Never commit real values.

# Neon (or any PostgreSQL 15+) connection string. Use the POOLED connection string on Vercel.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/sports_eqp

# Public origin of the app, exactly as users type it (no trailing slash). Used for CSRF origin checks and cookie security.
APP_ORIGIN=http://localhost:3000

# Long random string (at least 32 characters). Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
OTP_HMAC_SECRET=change-me-to-a-long-random-string-of-48-characters

# Comma-separated email domains allowed to sign in.
ALLOWED_EMAIL_DOMAINS=vitbhopal.ac.in

# Department admin mailbox(es), comma-separated. Signing in with one of these always gives FR Sports (administrator)
# and opens the admin dashboard directly, with no profile form.
ADMIN_EMAILS=fr.sports@vitbhopal.ac.in

# Email transport: "smtp" in production; "console" prints emails to the server log (development only, refused in production).
MAIL_TRANSPORT=console
MAIL_FROM="VIT Bhopal Sports Store <sports-store@vitbhopal.ac.in>"

# Google Workspace. Preferred: SMTP relay service (host smtp-relay.gmail.com, port 587, SMTP auth with the sending account).
# Simpler: host smtp.gmail.com, port 587, the sending account's app password.
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_USER=sports-store@vitbhopal.ac.in
SMTP_PASS=

# Shared secret for scheduled jobs (Vercel Cron / GitHub Actions) calling /api/cron/* endpoints.
CRON_SECRET=change-me-too
